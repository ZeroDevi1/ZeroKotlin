<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.zerokotlin.system.mapper.AnnouncementMapper">
    <resultMap id="inboxEntry" type="dev.zerokotlin.system.dto.InboxEntry">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="title" javaType="string"/>
            <arg column="body" javaType="string"/>
            <arg column="published_at" javaType="_long"/>
            <arg column="read_at" javaType="long"/>
        </constructor>
    </resultMap>

    <sql id="inboxRows">
        FROM sys_announcement a
        LEFT JOIN sys_announcement_read r ON r.announcement_id = a.id AND r.user_id = #{userId}
        WHERE a.status = 'PUBLISHED'
        <if test="unreadOnly">
            AND r.user_id IS NULL
        </if>
    </sql>

    <select id="findInbox" resultMap="inboxEntry">
        SELECT a.id, a.title, a.body, a.published_at, r.read_at
        <include refid="inboxRows"/>
        ORDER BY a.published_at DESC, a.id DESC
        LIMIT #{window.size} OFFSET #{window.offset}
    </select>

    <select id="countInbox" resultType="long">
        SELECT COUNT(*)
        <include refid="inboxRows"/>
    </select>

    <insert id="insertUnreadAsRead">
        <bind name="unreadOnly" value="true"/>
        INSERT INTO sys_announcement_read (user_id, announcement_id, read_at)
        SELECT #{userId}, a.id, #{now}
        <include refid="inboxRows"/>
    </insert>
</mapper>
