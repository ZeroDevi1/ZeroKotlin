<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.zerokotlin.system.mapper.UserMapper">
    <resultMap id="userRow" type="dev.zerokotlin.system.dto.UserRow">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="display_name" property="displayName"/>
        <result column="department_id" property="departmentId"/>
        <result column="enabled" property="enabled"/>
    </resultMap>

    <sql id="departmentTree">
        <if test="query.scope == 'DEPARTMENT_AND_DESCENDANTS' and query.actorDepartmentId != null">
            WITH RECURSIVE visible_department (id) AS (
                SELECT id FROM sys_department WHERE id = #{query.actorDepartmentId}
                UNION
                SELECT d.id FROM sys_department d
                JOIN visible_department v ON v.id = d.parent_id
            )
        </if>
    </sql>

    <sql id="visibleUser">
        <choose>
            <when test="query.scope == 'ALL'">
                1 = 1
            </when>
            <when test="query.scope == 'DEPARTMENT' and query.actorDepartmentId != null">
                u.department_id = #{query.actorDepartmentId}
            </when>
            <when test="query.scope == 'DEPARTMENT_AND_DESCENDANTS' and query.actorDepartmentId != null">
                u.department_id IN (SELECT id FROM visible_department)
            </when>
            <otherwise>
                u.id = #{query.actorId}
            </otherwise>
        </choose>
    </sql>

    <sql id="userFilters">
        WHERE <include refid="visibleUser"/>
        <if test="query.departmentId != null">
            AND u.department_id = #{query.departmentId}
        </if>
        <if test="query.roleId != null">
            AND EXISTS (
                SELECT 1 FROM sys_user_role ur WHERE ur.user_id = u.id AND ur.role_id = #{query.roleId}
            )
        </if>
    </sql>

    <sql id="userColumns">u.id, u.username, u.display_name, u.department_id, u.enabled</sql>

    <select id="countUsers" resultType="long">
        <include refid="departmentTree"/>
        SELECT COUNT(*) FROM sys_user u
        <include refid="userFilters"/>
    </select>

    <select id="findUsers" resultMap="userRow">
        <include refid="departmentTree"/>
        SELECT <include refid="userColumns"/> FROM sys_user u
        <include refid="userFilters"/>
        ORDER BY u.username, u.id
        LIMIT #{window.size} OFFSET #{window.offset}
    </select>

    <select id="findVisible" resultMap="userRow">
        <include refid="departmentTree"/>
        SELECT <include refid="userColumns"/> FROM sys_user u
        WHERE u.id = #{id} AND (<include refid="visibleUser"/>)
    </select>

    <select id="findSessionActor" resultMap="userRow">
        SELECT <include refid="userColumns"/>
        FROM sys_session s JOIN sys_user u ON u.id = s.user_id AND u.enabled = 1
        WHERE s.digest = #{digest} AND s.expires_at &gt; #{now}
    </select>

    <select id="findPositionMembers" resultMap="userRow">
        SELECT <include refid="userColumns"/>
        FROM sys_user_position up JOIN sys_user u ON u.id = up.user_id
        WHERE up.position_id = #{positionId}
        ORDER BY u.username, u.id
    </select>
</mapper>
